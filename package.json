{
  "name": "connect-ai-slides-web",
  "version": "0.4.0",
  "description": "Your AI agent becomes a presentation employee: a few lines of markdown, Marp or Slidev, or your old PowerPoint file, become a real PowerPoint file. Every word is an editable text box, each slide's motion plays as a clip, the words fade in on time, and your speaker notes come along. The same story is also a deck in the browser and a one-page website, from 67 motion blocks (GSAP, Motion, anime.js, Lottie, CSS, HyperFrames, Remotion), checked on the real screen.",
  "type": "module",
  "bin": {
    "connect-ai-slides-web": "bin/cli.mjs"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "tsc": "tsc -p tsconfig.json",
    "demo": "node bin/cli.mjs demo",
    "ppt": "node bin/cli.mjs ppt",
    "check": "node bin/cli.mjs check",
    "gallery": "node bin/cli.mjs gallery",
    "dogfood": "node scripts/dogfood.mjs dogfood-out",
    "cs": "node bin/cli.mjs"
  },
  "license": "MIT",
  "author": "CONNECT AI LAB",
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonseokjung/connect-ai-slides-web.git"
  },
  "homepage": "https://github.com/wonseokjung/connect-ai-slides-web#readme",
  "bugs": {
    "url": "https://github.com/wonseokjung/connect-ai-slides-web/issues"
  },
